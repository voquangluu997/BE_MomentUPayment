# ============================================
# DATABASE CONFIGURATION
# ============================================
# For local development with docker-compose
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/moment_db?schema=public"
# Direct connection (for migrations)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/moment_db"

# Or use Supabase (Production)
# DATABASE_URL="postgresql://user:password@host:5432/db?schema=public"
# DIRECT_URL="postgresql://user:password@host:5432/db"

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=8001
NODE_ENV=development

# ============================================
# JWT AUTHENTICATION
# ============================================
JWT_SECRET="your_super_secret_jwt_key_change_this_in_production"

# ============================================
# REDIS CONFIGURATION (For Caching & Job Queue)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password

# ============================================
# CLOUDINARY (Image Upload Service)
# ============================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ============================================
# EMAIL SERVICE (Resend/SMTP)
# ============================================
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_USER=resend
MAIL_PASS=your_resend_api_key

# ============================================
# GOOGLE OAUTH & GMAIL
# ============================================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_MAIL_PASS=your_google_app_password

# ============================================
# ADMIN SECURITY
# ============================================
ADMIN_SECRET_KEY=your_admin_secret_key

# ============================================
# API CONFIGURATION
# ============================================
API_BASE_URL=http://localhost:8001

# For production: https://api.yourdomain.com
# For staging: https://api-staging.yourdomain.com
