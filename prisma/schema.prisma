// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}
model User {
  id                  String         @id @default(uuid())
  email               String         @unique
  password            String?
  name                String?
  avatar              String?
  isEmailVerified     Boolean        @default(false)
  verificationToken   String?        @unique
  googleId            String?        @unique
  appleId             String?        @unique
  budgetLimit         Float?
  fcmToken            String?
  language            String         @default("vi")
  isFirstLogin        Boolean        @default(true)
  resetPasswordOtp    String?
  resetPasswordExpires DateTime?
  timezone            String?        @default("Asia/Ho_Chi_Minh")

  // 🔑 Cài đặt thông báo (Opt-in / Opt-out)
  notiBudgetAlerts    Boolean        @default(true)
  notiSecuritySystem  Boolean        @default(true)
  notiSharedWallet    Boolean        @default(true)

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @default(now()) @updatedAt
  transactions        Transaction[]
  notifications       Notification[]
  badges              UserBadge[]
}

model Transaction {
  id       Int      @id @default(autoincrement())
  amount   Float
  note     String?
  imageUrl String?
  category String   @default("General")
  emoji    String? // Lưu cảm xúc 🥰, 💸
  spentAt  DateTime @default(now())
  userId   String
  // Cấu hình Cascade Delete
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  // Cấu hình Cascade Delete
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 🔑 Thay thế title/body bằng Key đa ngôn ngữ và tham số
  type        String   // VD: 'budget_80', 'budget_100', 'email_verified', 'aggregated_tx'
  titleKey    String   // VD: 'notiBudgetWarningTitle'
  bodyKey     String   // VD: 'notiBudgetWarningBody'
  arguments   String[] @default([]) // Array lưu biến số VD: ["Tiền cà phê", "85"]

  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model UserBadge {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId    String   // Lưu ID huy hiệu từ Flutter gửi lên, VD: 'firstBlood', 'richKid'
  unlockedAt DateTime @default(now())

  // Ràng buộc quan trọng: Một user chỉ được mở khóa một loại huy hiệu DUY NHẤT 1 lần
  @@unique([userId, badgeId])
}